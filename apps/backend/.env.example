# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=PregnantBot
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins (production only)
CORS_ORIGINS=https://app.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Swagger (production only)
# ─────────────────────────────────────────────────────────────────────────────
SWAGGER_SERVER_URL=http://backend:3000

# ─────────────────────────────────────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=pregnantbot
DB_PASSWORD=
DB_NAME=pregnantbot

# ─────────────────────────────────────────────────────────────────────────────
# API access
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret used by consumers via X-API-KEY header
API_KEY=
TELEGRAM_BOT_TOKEN=
# Optional override for local E2E; defaults to https://api.telegram.org.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Telegram account IDs are assigned explicitly by patient role.
TELEGRAM_WIFE_USER_ID=
TELEGRAM_HUSBAND_USER_ID=
# Required public HTTPS webhook endpoint for production (for example https://app.example.com/api/webhooks/telegram).
# TELEGRAM_WEBHOOK_SECRET is required and setWebhook is registered at app startup.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Scheduled reminders use Asia/Tbilisi and send at 11:00 local time.

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible object storage (local Garage defaults)
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pregnantbot
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────────────────────
# HTTP client (for external service calls)
# ─────────────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=3
HTTP_RETRY_DELAY_MS=1000

# OpenAI medical-document interpretation (used only after explicit user action)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
